# Copy to: CreditScoringSystem/backend/.env   (then edit the values)
# Never commit the real .env to Git.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,backend

DB_NAME=credit_scoring_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Days a credit score stays valid (stored per assessment when it is created).
SCORE_VALIDITY_DAYS=30

# Lipa na M-Pesa till statements: minimum length (days), age before a warning (days), and whether a
# name or till-number mismatch rejects the statement (1) or only warns (0).
STATEMENT_MIN_DAYS=85
STATEMENT_MAX_AGE_DAYS=30
STATEMENT_STRICT_IDENTITY=0
